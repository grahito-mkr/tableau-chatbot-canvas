<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.yourcompany.ai-canvas" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name name-locale="en_US">AI Canvas Assistant</name>
    <description>Ask questions about your data and generate dashboard widgets with AI, right on the canvas.</description>
    <author name="Mekari Data Team" email="data-team-1@mekari.com" organization="Mekari" website="https://mekari.com" />
    <min-api-version>1.9</min-api-version>

    <!-- REPLACE with your deployed Vercel URL, e.g. https://tableau-ai-canvas.vercel.app/extension -->
    <source-location>
      <url>https://tableau-chatbot-canvas.vercel.app</url>
    </source-location>

    <!-- 1x1 transparent PNG placeholder - swap in a real 96x96 icon before publishing -->
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=</icon>

    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
</manifest>
